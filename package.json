    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto-js": "^4.2.0",
    "ioredis": "^5.4.1",
    "json2csv": "^6.0.0-alpha.2",
    "jwks-rsa": "^3.1.0",
    "libphonenumber-js": "^1.12.5",
    "moment-timezone": "^0.5.48",
    "nanoid": "^3.3.0",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
